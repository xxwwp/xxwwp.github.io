---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { pathJoin } from "../../utils/path-join";
import IconTime from "../../components/icon-time.astro";
import IconTag from "../../components/icon-tag.astro";
import IconArchives from "../../components/icon-archives.astro";

const posts = (await getCollection("docs")).sort((a, b) => b.data.createAt.valueOf() - a.data.createAt.valueOf());
---

<!doctype html>
<html lang='zh-CN'>
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <section class='max-w-4xl mx-auto p-4'>
        <ul class='grid grid-cols-1 gap-4'>
          {
            posts.map(post => (
              <li
                class='border border-gray-200 rounded-md p-4 
              hover:border-blue-500 hover:text-blue-500 transition-all duration-100'
              >
                <div class='flex items-center justify-between'>
                  <a href={pathJoin(["/docs", post.data.slug])}>
                    <h4 class='text-lg font-bold'>{post.data.title}</h4>
                  </a>
                </div>

                {post.data.desc && <div class='text-gray-500 text-xs mt-2'>{post.data.desc}</div>}

                <div class='flex items-center flex-wrap gap-1 text-xs text-gray-500 mt-2'>
                  <IconTime class='w-3 h-3 text-blue-400 inline align-baseline' />
                  <span>：</span>
                  <FormattedDate date={post.data.createAt} />

                  {post.data.tags && (
                    <>
                      <IconTag class='w-3 h-3 text-blue-400 inline align-baseline ml-2' />
                      <span>：</span>
                      {post.data.tags.map((tag, i) => (
                        <>
                          <span>{tag}</span>
                          {i !== post.data.tags!.length - 1 && <span>,</span>}
                        </>
                      ))}
                    </>
                  )}

                  {post.data.archives && (
                    <>
                      <IconArchives class='w-3 h-3 text-blue-400 inline align-baseline ml-2' />
                      <span>：</span>
                      {post.data.archives.map((archive, i) => (
                        <>
                          <span>{archive}</span>
                          {i !== post.data.archives!.length - 1 && <span>,</span>}
                        </>
                      ))}
                    </>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
