---
import { ccby } from "../assets/ccby";
import Anchor from "./Anchor.astro";
interface Props {
  tags: string[];
  archives: string[];
}
const { tags, archives } = Astro.props;
---

<section class='mt-20 break-all text-sm
       border border-gray-200 rounded-md p-4
       bg-gray-50 footer-info'>
  <div class='text-2xl font-bold mb-4'>关于此文档</div>
  <div>
    <span>版权声明：</span>
    <img src={ccby} class='inline-block' alt='' />
    <Anchor href='https://creativecommons.org/licenses/by-nc-nd/4.0/' target='_blank' rel='noopener noreferrer'>
      署名-非商业性使用-禁止演绎 4.0 国际 (CC BY-NC-ND 4.0)
    </Anchor>
  </div>
  <div>本文地址：<Anchor href={Astro.url}>{decodeURIComponent(Astro.url.toString())}</Anchor></div>
  <div>标签：{tags.join(", ")}</div>
  <div>归档：{archives.join(", ")}</div>
</section>
