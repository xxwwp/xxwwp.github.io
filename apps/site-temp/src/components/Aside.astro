---
import type { MarkdownHeading } from "astro";
interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
---

<aside class='hidden sm:flow-root sticky top-20 left-0 h-full border-r sm:border-r-0 border-gray-200 w-64 shrink-0'>
  <div class='text-sm text-gray-500 leading-6 m-4'>目录</div>

  <ul class='m-4' data-id='aside-list'>
    {
      headings.map(heading => (
        <li
          data-id={heading.slug}
          class:list={[
            {
              "ml-2": heading.depth === 3,
              "ml-4": heading.depth === 4,
              "ml-6": heading.depth === 5,
              "ml-8": heading.depth === 6,
            },
            "text-sm text-gray-500 leading-6",
          ]}
        >
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))
    }
  </ul>
</aside>
<style>
  li.active {
    color: var(--color-blue-500);
    font-weight: bolder;
  }
</style>
