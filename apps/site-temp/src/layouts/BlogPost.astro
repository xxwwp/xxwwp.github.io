---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import "./content.css";
import { GIT_REPO_URL } from "../consts";
import IconHistory from "../components/icon-history.astro";
import IconEdit from "../components/icon-edit.astro";
import Anchor from "../components/Anchor.astro";
import type { MarkdownHeading } from "astro";
import Aside from "../components/Aside.astro";
import AbortDoc from "../components/AbortDoc.astro";
type Props = CollectionEntry<"docs">["data"] & {
  headings: MarkdownHeading[];
};

const { title, desc, createAt, heroImage, tags = [], archives = [], headings } = Astro.props;
---

<html lang='zh-CN'>
  <head>
    <BaseHead title={title} description={desc || ""} />
    <style>
      .footer-info > div:first-child {
        line-height: 2;
      }
    </style>
  </head>

  <body>
    <Header />

    <main class='relative flex flex-col sm:flex-row justify-center gap-4'>
      <Aside headings={headings} />

      <article data-id='article' class='max-w-4xl lg:max-w-6xl xl:max-w-7xl 2xl:max-w-8xl p-4 prose'>
        {heroImage && <img width={1020} src={heroImage} alt='' />}
        <h1>{title}</h1>
        <div class='flex items-center gap-2 text-gray-500 text-xs my-2'>
          <span class='mr-auto'>创建：<FormattedDate date={createAt} /></span>

          <Anchor
            href={`${GIT_REPO_URL}/edit/temp/docs/${Astro.props.id}.md`}
            target='_blank'
            class='flex items-center gap-1'
            rel='noopener noreferrer'
          >
            <IconEdit class='w-4 h-4' />
            <span>编辑</span>
          </Anchor>

          <span class='w-1 h-1 bg-gray-500 rounded-full' title='dot 分割'></span>

          <Anchor
            href={`${GIT_REPO_URL}/commits/temp/docs/${Astro.props.id}.md`}
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center gap-1'
          >
            <IconHistory class='w-4 h-4' />
            <span>提交历史</span>
          </Anchor>
        </div>
        <hr class='mt-1 mb-8' />

        <slot />

        <AbortDoc tags={tags} archives={archives} />
      </article>
    </main>
    <Footer />
  </body>
</html>

<script src='./blog-post.ts'></script>
